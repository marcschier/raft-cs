<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>RaftCs.Storage.File</PackageId>
    <RootNamespace>Raft.Storage.File</RootNamespace>
    <AssemblyName>Raft.Storage.File</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>A simple crash-safe append-only file (WAL/segment) implementation of the Raft IRaftStorage abstraction, persisting log entries, hard state, and snapshots.</Description>
    <PackageTags>raft;consensus;storage;wal;persistence;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Raft.Storage.File.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Raft\Raft.csproj" />
  </ItemGroup>

  <!-- File ACLs are in-box on net8+; netstandard needs the package to create files with an explicit DACL. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.IO.FileSystem.AccessControl" />
  </ItemGroup>

</Project>
